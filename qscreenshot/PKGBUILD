# Maintainer: alex korobtsov <korobcoff@gmail.com>
pkgname=qscreenshot-git
pkgver=1.1.r164.e340f06
pkgrel=1
pkgdesc="Simple creation and editing of screenshots"
arch=('i686' 'x86_64')
url="https://sourceforge.net/projects/qscreenshot/"
license=('GPL2')
depends=('qt5-base' 'qt5-x11extras' 'libx11')
makedepends=('git' 'cmake' 'qt5-tools')
provides=('qscreenshot')
conflicts=('qscreenshot')
source=('git+https://git.code.sf.net/p/qscreenshot/code')
sha256sums=('SKIP')

pkgver() {
  cd code
  _ver=$(sed -n 's/^#define APP_VERSION "\(.*\)"/\1/p' qScreenshot/src/defines.h)
  printf "%s.r%s.%s" "$_ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  # newer CMake releases dropped compatibility with cmake_minimum_required < 3.5
  sed -i 's/cmake_minimum_required( *VERSION 3.2.0 *)/cmake_minimum_required(VERSION 3.10)/' \
    code/qScreenshot/CMakeLists.txt code/qScreenshot/cmake/modules/version.cmake
}

build() {
  cmake -S code/qScreenshot -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
