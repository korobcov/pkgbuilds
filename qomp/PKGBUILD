# Maintainer: alex korobtsov <korobcoff@gmail.com>
pkgname=qomp-git
pkgver=1.5.r18.gdc84b90
pkgrel=1
pkgdesc="Quick(Qt) Online Music Player"
arch=('i686' 'x86_64')
url="https://github.com/qomp/qomp"
license=('GPL2')
depends=('qt6-base' 'qt6-multimedia' 'qt6-5compat' 'taglib' 'libcue' 'libx11')
optdepends=('qt6-multimedia-ffmpeg: audio/video backend for playback'
            'qt6-multimedia-gstreamer: alternative playback backend')
makedepends=('git' 'cmake' 'qt6-tools')
provides=('qomp')
conflicts=('qomp' 'qomp-qt5-git')
source=('git+https://github.com/qomp/qomp.git'
        'git+https://github.com/qomp/translations.git'
        'git+https://github.com/qomp/themes.git'
        'git+https://github.com/wadealer/SingleApplication.git')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

_plugins="filesystemplugin;urlplugin;poiskmplugin;myzukaruplugin;notificationsplugin;yandexmusicplugin;lastfmplugin;tunetofileplugin;mprisplugin"

pkgver() {
  cd qomp
  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd qomp
  # ga (google analytics) and android_openssl are not needed on desktop
  git submodule init translations themes src/singleapplication
  git config submodule.translations.url "$srcdir/translations"
  git config submodule.themes.url "$srcdir/themes"
  git config submodule.src/singleapplication.url "$srcdir/SingleApplication"
  git -c protocol.file.allow=always submodule update translations themes src/singleapplication
}

build() {
  cmake -S qomp -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DUSE_QT6=ON \
    -DBUILD_PLUGINS="${_plugins}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
